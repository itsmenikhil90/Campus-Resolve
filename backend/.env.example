PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-comply
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
# Comma-separated browser origins allowed to call the API. Same-origin
# requests are allowed automatically; add separate frontend origins here.
FRONTEND_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_BUCKET=
AWS_REGION=
# Set S3_ENDPOINT for S3-compatible services such as Cloudflare R2.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
