PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-comply
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
# Comma-separated browser origins allowed to call the API. For same-origin
# deployment, use the public backend URL; for a separate static frontend,
# add its public URL as a second value.
FRONTEND_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
